# Copy to .env and change before sharing the machine with anyone.
POSTGRES_PASSWORD=officeai_dev
CEO_EMAIL=ceo@officeai.local
CEO_PASSWORD=ChangeMe-Dev-2026
CEO_NAME=CEO

# AI keys can also be entered on the AI settings page (they take precedence and need no restart).
# AI: leave ANTHROPIC_API_KEY empty to keep Claude disabled. SIMULATED_AI=false hides the development stand-in.
ANTHROPIC_API_KEY=
# Optional: OpenAI and Google Gemini. Add their models and prices in AI settings before assigning them.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama on this PC (free, no key). Default http://host.docker.internal:11434/v1; set to empty to turn it off.
# OLLAMA_URL=
# Knowledge search by meaning with an Ollama embedding model (run "ollama pull bge-m3" first). Empty = keyword search only.
# OLLAMA_EMBED_MODEL=bge-m3
# Optional: access tokens for pushing approved code to GitHub / GitLab (fine-grained token with "contents: write" on that repository).
GIT_REMOTE_GITHUB=
GIT_REMOTE_GITLAB=
SIMULATED_AI=true
# Optional licensed mascot image placed in frontend/public/characters
MASCOT_IMAGE=
# How many questions the Claude bridge answers at once (default 2). More is faster for AI employees and uses your Claude plan faster.
# CLAUDE_BRIDGE_CONCURRENCY=2
# The dashboard terminal is a full shell on this PC, so it stays off. To use it, uncomment this and restart scripts/windows/claude-bridge.mjs.
# CLAUDE_BRIDGE_TERMINAL=true
# Shared secret between the API and the sandbox runner
SANDBOX_RUNNER_TOKEN=change-me
# Optional: email notifications (people opt in on "My settings"). Leave EMAIL_HOST empty to send nothing.
# Gmail: smtp.gmail.com, port 587, StartTls, your address, and an App Password (not the account password).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURITY=StartTls
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
# Public address of the web app, used in email links (default http://localhost:3000)
APP_BASE_URL=
